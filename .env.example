# Copia este archivo como ".env" (sin ".example") y rellénalo.
# El archivo .env NO se sube a git ni se sirve por la web: contiene tus contraseñas.

# Servidor web
PORT=8080
HOST=0.0.0.0

# Clave para AGREGAR y ELIMINAR elementos del catálogo. Elige una larga y propia.
# Todos pueden VER el catálogo; solo quien tenga esta clave puede modificarlo.
ADMIN_KEY=cambia-esta-clave-larga

# Conexión a MySQL (el usuario se crea con database/crear_usuario.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=webbox
DB_PASSWORD=
DB_NAME=webbox

# Solo para pruebas sin MySQL (los datos se pierden al apagar): descomenta
# STORE=memory
