# Copia este archivo como ".env" (sin ".example") y rellénalo.
# El archivo .env NO se sube a git ni se sirve por la web: contiene tus contraseñas.

# Servidor web
PORT=8080
HOST=0.0.0.0

# --- Cuentas ---------------------------------------------------------------
# Al arrancar sin ninguna cuenta se crea el administrador con estos datos. Después cambia la
# contraseña desde Configuración > Cuenta (o crea más usuarios desde Configuración > Usuarios).
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contrasena
# Firma de las sesiones: una cadena larga y secreta (sin ella, las sesiones se cierran al reiniciar).
SESSION_SECRET=escribe-aqui-una-cadena-larga-y-aleatoria
# SESSION_DAYS=30        días que dura una sesión
# REQUIRE_LOGIN=1        1 (por defecto): hay que iniciar sesión para usar WebBox OS. 0: abierto a todos
# ALLOW_REGISTER=0       1: cualquiera puede crearse una cuenta de usuario normal desde la pantalla de acceso

# Clave heredada (opcional): sigue valiendo como acceso de administrador por la cabecera X-Admin-Key.
# Si no defines ADMIN_PASSWORD, se usa como contraseña del administrador inicial.
ADMIN_KEY=cambia-esta-clave-larga

# Base de datos: sqlite (por defecto, archivo database/webbox.sqlite, sin instalar nada),
# mysql o memory (solo pruebas).
# STORE=sqlite
# SQLITE_FILE=database/webbox.sqlite   (en Render con Disk: /var/data/webbox.sqlite)
# SEMBRAR=0   (por defecto, al arrancar se carga database/catalogo.json en la base)

# Solo si usas STORE=mysql. Conexión a MySQL (el usuario se crea con database/crear_usuario.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=webbox
DB_PASSWORD=
DB_NAME=webbox

# Solo para pruebas sin MySQL (los datos se pierden al apagar): descomenta
# STORE=memory
